{
  "name": "wexample/symfony-remote-elysee",
  "description": "elysee.fr as a symfony-remote: the publications of the Présidence de la République — releases, articles, the texts of the speeches —, read politely and kept on disk",
  "version": "1.0.1",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyRemoteElysee\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyRemoteElysee\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=19.3.0",
    "wexample/symfony-remote": ">=2.4.0",
    "wexample/php-remote": ">=4.0.0",
    "symfony/http-client": ">=7.0",
    "symfony/filesystem": ">=7.0",
    "ext-dom": "*",
    "ext-zlib": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}
